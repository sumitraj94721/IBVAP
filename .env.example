# =============================================================================
# IBVAP — Intelligent Border Video Analytics Platform (SIH 26187)
# Environment Configuration Template (.env.example)
# Copy this file to .env for local or production configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend Server & Environment
# -----------------------------------------------------------------------------
# Environment mode: development | production
IBVAP_ENV=development
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed frontend origins for CORS
IBVAP_CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176,http://localhost:8000
# Optional regex for dynamic cloud preview/deployment origins (e.g. Vercel)
IBVAP_CORS_ORIGIN_REGEX=https://.*\.vercel\.app
FRONTEND_URL=http://localhost:5176

# -----------------------------------------------------------------------------
# 2. Authentication & Security
# -----------------------------------------------------------------------------
# Cryptographic HMAC-SHA256 secret key for signing session tokens (min 32 chars in production)
IBVAP_AUTH_SECRET=change-this-to-a-64-char-cryptographic-secret-in-production

# Enable SIH 2026 demo credentials (admin / admin123, HQ-CDR-01, OP-SECT-04)
# Defaults to true in development, false in production unless explicitly set to true
IBVAP_ENABLE_DEMO_CREDENTIALS=true
DEMO_BYPASS_AUTH=false

# Optional production administrator account bootstrap (seeded into SQLite on startup)
IBVAP_ADMIN_USER=admin
IBVAP_ADMIN_PASSWORD=admin123
IBVAP_ADMIN_NAME=Insp. Vikram Singh

# -----------------------------------------------------------------------------
# 3. SQLite Database & Persistent Storage
# -----------------------------------------------------------------------------
# Directory or explicit file paths for SQLite databases
IBVAP_DATA_DIR=./backend/data
# IBVAP_DB_PATH=./backend/security.db
# IBVAP_EDGE_DB_PATH=./ibvap_edge.db

# -----------------------------------------------------------------------------
# 4. AI / Computer Vision Pipeline Configuration
# -----------------------------------------------------------------------------
# Primary Ultralytics YOLOv8 model weights path
IBVAP_YOLO_MODEL=yolov8n.pt
# Optional custom fine-tuned weights for weapons or border structures (bunkers/posts)
# IBVAP_WEAPON_MODEL=models/weapons_yolov8n.pt
# IBVAP_STRUCTURE_MODEL=models/structures_yolov8n.pt

# -----------------------------------------------------------------------------
# 5. Edge & Remote Camera Streams (CAM-02 / Edge Node)
# -----------------------------------------------------------------------------
CAM2_ENABLED=false
CAM2_NAME=Sector Bravo
CAM2_SOURCE_TYPE=EDGE_NODE
CAM2_STREAM_URL=
EDGE_NODE=false
EDGE_CAMERA_INDEX=0

# -----------------------------------------------------------------------------
# 6. Frontend Build-Time Variables (Vite / Vercel)
# -----------------------------------------------------------------------------
# Leave empty when running with Vite local proxy or unified Docker container.
# Set to your deployed backend URL when hosting frontend separately on Vercel:
# VITE_API_URL=https://ibvap-backend.onrender.com
# VITE_WS_URL=wss://ibvap-backend.onrender.com
VITE_API_URL=
VITE_WS_URL=
